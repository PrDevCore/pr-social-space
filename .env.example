# --- Firebase (Firestore) ---
# Service account key: Firebase console -> Project settings -> Service
# accounts -> Generate new private key. These three values come from that
# JSON. In .env files write FIREBASE_PRIVATE_KEY on ONE line with \n escapes
# (the app normalizes them). On Vercel you can paste it multiline.
FIREBASE_PROJECT_ID=social-hub-12345
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@social-hub-12345.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Firebase (browser SDK config, public / NOT secret) ---
# From Firebase console -> Project settings -> General -> Your apps. Only
# needed if you add client-side Firebase usage (e.g. Firebase Auth) later.
# NEXT_PUBLIC_* vars are exposed to the browser by design.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxxxx

# --- Custom auth (email/password) ---
# No external provider: users, password hashes (Argon2id) and sessions are
# stored in Firebase Firestore via lib/store.ts.
# Optional server-side pepper prepended to every password before hashing.
# If set in production, keep it stable and NEVER rotate it, or users can't
# log in. A DB leak alone can't brute-force peppered+Argon2id hashes.
# PASSWORD_PEPPER=a-long-random-server-secret

# --- Zernio (social posting API) ---
# Server-side ONLY. Never expose this to the browser.
# Create a key at https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZERNIO_API_BASE=https://zernio.com/api/v1

# Used for building the return trip after a user connects a social account.
# Zernio redirects the browser back to <APP_URL>/api/social/callback.
APP_URL=http://localhost:3000

# --- SEO ---
# Canonical public domain used for metadataBase, sitemap, canonical links and
# structured data. Overrides the default https://prsocialhub.space.
# SITE_URL=https://prsocialhub.space
# Google Search Console / Bing Webmaster verification meta tags (optional).
# Leave unset to skip emitting the meta tags.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_BING_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: verifies the Zernio webhook (account.connected, post.*, ...).
# Configure a webhook in the Zernio dashboard pointing at
# https://yourdomain.com/api/webhooks/zernio and set the same secret here.
ZERNIO_WEBHOOK_SECRET=zwhsec_xxxxxxxxxxxx

# --- Groq (AI captions, hashtags, tone) ---
# Server-side ONLY. Never expose this to the browser.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for text generation. `llama-3.3-70b-versatile` is the default.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Flutterwave (billing) ---
# Server-side ONLY for the secret key. Get keys (test/live) at
# https://dashboard.flutterwave.com -> Settings -> API Keys.
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Hash you set under Settings -> Webhooks -> Secret Hash. Used to verify the
# verif-hash header on /api/billing/webhook.
FLW_WEBHOOK_HASH=xxxxxxx
# Optional currency override for local dev ("USD" or "NGN"). When unset the
# currency is chosen by IP country: Nigeria -> NGN, everywhere else -> USD.
# FLW_CURRENCY=NGN
